{
  "version": 2,
  "description": "Shared TypeScript/Python golden fixtures for the deterministic project-cost estimation core. Source of truth: docs/api-contract.md and docs/estimation-engine.md. Consumed by src/estimation/shared-fixture.test.ts and backend/tests/test_shared_fixture.py.",
  "notes": [
    "Expected values are computed by hand from the documented rules (per-line half-up rounding to 2 decimals, then each section subtotal is rounded, then the total) and were NOT produced by calling the implementation under test.",
    "Non-finite numbers are encoded as the strings \"Infinity\", \"-Infinity\" and \"NaN\"; harnesses convert them to the language's non-finite float.",
    "sections() expectation mirrors each error's `section` value; both runtimes must agree on validation order."
  ],
  "rounding": {
    "currencyDecimals": 2,
    "policy": "half-up; applied per line, then each section subtotal, then the total"
  },
  "roundingCases": [
    { "input": 1.005, "expected": 1.01 },
    { "input": 2.675, "expected": 2.68 },
    { "input": 0.005, "expected": 0.01 },
    { "input": 10.124, "expected": 10.12 },
    { "input": 1.111, "expected": 1.11 },
    { "input": 100, "expected": 100 },
    { "input": 4100, "expected": 4100 },
    { "input": 0, "expected": 0 }
  ],
  "cases": [
    {
      "id": "personnel-only",
      "description": "2 engineers x 100 h x 50 = 10000.",
      "request": {
        "projectName": "Demo build",
        "currency": "USD",
        "personnel": [{ "role": "Engineer", "people": 2, "hours": 100, "hourlyRate": 50 }],
        "tooling": [],
        "infrastructure": [],
        "other": []
      },
      "expect": {
        "ok": true,
        "currency": "USD",
        "projectName": "Demo build",
        "lineCount": 1,
        "personnelCost": 10000,
        "toolingCost": 0,
        "infrastructureCost": 0,
        "otherCost": 0,
        "total": 10000
      }
    },
    {
      "id": "multi-section",
      "description": "16000 + 1200 + 900x6 + 500 = 23100.",
      "request": {
        "projectName": "Platform build",
        "currency": "EUR",
        "personnel": [{ "role": "Lead", "people": 1, "hours": 200, "hourlyRate": 80 }],
        "tooling": [{ "name": "Design suite", "amount": 1200 }],
        "infrastructure": [{ "name": "Cloud", "monthlyCost": 900, "months": 6 }],
        "other": [{ "description": "Licence transfer", "amount": 500 }]
      },
      "expect": {
        "ok": true,
        "currency": "EUR",
        "projectName": "Platform build",
        "lineCount": 4,
        "personnelCost": 16000,
        "toolingCost": 1200,
        "infrastructureCost": 5400,
        "otherCost": 500,
        "total": 23100
      }
    },
    {
      "id": "zero-values",
      "description": "All-zero personnel line is valid and yields zero.",
      "request": {
        "currency": "INR",
        "personnel": [{ "role": "Intern", "people": 0, "hours": 0, "hourlyRate": 0 }],
        "tooling": [],
        "infrastructure": [],
        "other": []
      },
      "expect": { "ok": true, "currency": "INR", "lineCount": 1, "total": 0 }
    },
    {
      "id": "empty-request",
      "description": "No cost lines at all is EMPTY_REQUEST.",
      "request": {
        "currency": "USD",
        "personnel": [],
        "tooling": [],
        "infrastructure": [],
        "other": []
      },
      "expect": { "ok": false, "errorCodes": ["EMPTY_REQUEST"] }
    },
    {
      "id": "unsupported-currency",
      "description": "GBP is not a supported currency.",
      "request": {
        "currency": "GBP",
        "personnel": [{ "role": "Engineer", "people": 1, "hours": 1, "hourlyRate": 1 }],
        "tooling": [],
        "infrastructure": [],
        "other": []
      },
      "expect": { "ok": false, "errorCodes": ["UNSUPPORTED_CURRENCY"] }
    },
    {
      "id": "invalid-personnel-role-and-people",
      "description": "Blank role and negative people produce two personnel errors.",
      "request": {
        "currency": "USD",
        "personnel": [{ "role": "   ", "people": -1, "hours": 10, "hourlyRate": 20 }],
        "tooling": [],
        "infrastructure": [],
        "other": []
      },
      "expect": {
        "ok": false,
        "errorCodes": ["INVALID_PERSONNEL", "INVALID_PERSONNEL"],
        "sections": ["personnel", "personnel"],
        "lineIndexes": [0, 0]
      }
    },
    {
      "id": "invalid-tooling-amount",
      "description": "A negative tooling amount is INVALID_TOOLING.",
      "request": {
        "currency": "USD",
        "personnel": [],
        "tooling": [{ "name": "Suite", "amount": -5 }],
        "infrastructure": [],
        "other": []
      },
      "expect": {
        "ok": false,
        "errorCodes": ["INVALID_TOOLING"],
        "sections": ["tooling"],
        "lineIndexes": [0]
      }
    },
    {
      "id": "rounding-half-twice",
      "description": "Two tooling lines of 0.005 round to 0.01 each; total 0.02.",
      "request": {
        "currency": "USD",
        "personnel": [],
        "tooling": [
          { "name": "A", "amount": 0.005 },
          { "name": "B", "amount": 0.005 }
        ],
        "infrastructure": [],
        "other": []
      },
      "expect": { "ok": true, "currency": "USD", "lineCount": 2, "total": 0.02 }
    },
    {
      "id": "invalid-nan-personnel",
      "description": "A NaN people value is INVALID_PERSONNEL.",
      "request": {
        "currency": "USD",
        "personnel": [{ "role": "Engineer", "people": "NaN", "hours": 10, "hourlyRate": 20 }],
        "tooling": [],
        "infrastructure": [],
        "other": []
      },
      "expect": { "ok": false, "errorCodes": ["INVALID_PERSONNEL"], "lineIndexes": [0] }
    }
  ]
}
