# Base URL for the estimation API.
# Leave unset during development to use the Vite dev proxy (see vite.config.ts),
# which forwards /api requests to the FastAPI service on http://localhost:8000.
# For a deployed frontend, set this to the full API base including the version prefix,
# for example: VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_API_BASE_URL=
